# Varnam Bangles admin environment variables
# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# --- GitHub (personal access token, repo scope, contents:read + contents:write) ---
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=TarunBonu547
GITHUB_REPO=varnam-bangles
GITHUB_BRANCH=main

# --- Admin session ---
SESSION_SECRET=a_long_random_string_at_least_32_chars
SESSION_NAME=varnam_admin
SESSION_MAX_AGE_MS=28800000

# --- Administrator credentials ---
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH: a bcrypt hash of the admin password. Generate with:
#   node -e "require('bcryptjs').hash('your-chosen-password', 12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=$2a$12$your_bcrypt_hash_here

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Data cache (ms). How long the server caches products.json/categories.json from GitHub.
DATA_CACHE_TTL_MS=60000
