<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Varnam Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-mobile.css">
</head>
<body class="admin-page">
<header class="site-header admin-header">
  <div class="admin-topbar-inner">
    <a class="brand admin-brand-link" href="/admin">VARNAM<small class="admin-brand-small"> ADMIN</small></a>
    <button class="mobile-menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="admin-nav">
      <svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
    <a href="/" class="btn btn-outline btn-sm admin-view-site">View website ↗</a>
  </div>
  <button class="mobile-menu-close" aria-label="Close navigation">
    <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <div class="admin-overlay" id="adminOverlay"></div>
</header>
<div class="admin-shell">
  <aside class="admin-sidebar">
    <div class="brand">VARNAM<small class="admin-brand-small"> ADMIN</small></div>
    <nav id="admin-nav">
      <a class="<%= (locals.active==='dashboard')?'active':'' %>" href="/admin">Dashboard</a>
      <a class="<%= (locals.active==='products')?'active':'' %>" href="/admin/products">Products</a>
      <a class="<%= (locals.active==='categories')?'active':'' %>" href="/admin/categories">Categories</a>
    </nav>
    <div class="admin-signed-in">
      Signed in as <strong class="admin-email"><%= locals.adminEmail %></strong><br>
      <form action="/admin/logout" method="POST" class="admin-logout-form">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <button class="btn btn-outline btn-sm admin-logout-btn" type="submit">Sign out</button>
      </form>
    </div>
  </aside>
  <div class="admin-body">
    <% if (locals.flash) { %><p class="admin-message <%= locals.flash.type %>"><%- locals.flash.message %></p><% } %>

<script src="/js/admin-nav.js" defer></script>

