{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://varnambangles.example/schema/product.v1.json",
  "title": "Varnam Bangles product",
  "type": "object",
  "required": ["id", "name", "slug", "description", "price", "category", "material", "sizes", "colour", "images", "stockStatus", "available", "published", "featured", "bestseller", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique product ID; lowercase letters, numbers, hyphens" },
    "slug": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "price": { "type": "number", "minimum": 0 },
    "originalPrice": { "type": ["number", "null"], "minimum": 0 },
    "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "image": { "type": "string" },
    "category": { "type": "string" },
    "material": { "type": "string" },
    "sizes": { "type": "array", "items": { "type": "string" } },
    "colour": { "type": "string" },
    "colours": { "type": "array", "items": { "type": "string" } },
    "stockStatus": { "type": "string", "enum": ["in_stock", "out_of_stock"] },
    "available": { "type": "boolean" },
    "published": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "bestseller": { "type": "boolean" },
    "meeshoUrl": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
